{
    "platform": "guybrush",
    "mode_switcher_type": "menu_switcher",
    "chrome_ec": true,
    "ec_capability": {
        "adc_ectemp": false,
        "arm": false,
        "battery": true,
        "cbi": true,
        "charging": true,
        "doubleboot": false,
        "keyboard": true,
        "lid": true,
        "peci": false,
        "smart_usb_charge": true,
        "thermal": false,
        "usb": true,
        "usbpd_uart": false,
        "x86": true
    },
    "servo_prog_state_delay": 1.0,
    "smm_store": false,
    "firmware_screen": 15,
    "delay_powerinfo_stable": 5,
    "custom_usb_enable_pins": [
        {
            "name": "EN_PP5000_USB_A0_VBUS",
            "ioex": true
        },
        {
            "name": "EN_PP5000_USB_A1_VBUS_DB",
            "ioex": true
        }
    ],
    "max_charging_power": 100.0,
    "ap_flash_ccd_programmer": "raiden_debug_spi:target=AP,custom_rst=True,serial=%s",
    "ap_flash_ccd_pre_commands": ["ec_uart_cmd:apshutdown", "sleep:5"],
    "ap_flash_ccd_post_commands": ["power_state:reset"],
    "cr50_capability": {
        "ec_hibernate_breaks_rdd": false,
        "wp_on_in_g3": false,
        "rdd_off_in_g3": false,
        "rdd_leakage": false
    }
}
