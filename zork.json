{
    "platform": "zork",
    "mode_switcher_type": "menu_switcher",
    "chrome_ec": true,
    "ec_capability": [
        "battery",
        "charging",
        "keyboard",
        "lid",
        "x86",
        "usb",
        "smart_usb_charge",
        "cbi"
    ],
    "servo_prog_state_delay": 1.0,
    "smm_store": false,
    "firmware_screen": 15,
    "usb_image_boot_timeout": 240,
    "delay_powerinfo_stable": 5,
    "custom_usb_enable_pins": [
        {
            "name": "EN_USB_A0_5V",
            "ioex": true
        },
        {
            "name": "EN_USB_A1_5V_DB",
            "ioex": true
        }
    ]
}
